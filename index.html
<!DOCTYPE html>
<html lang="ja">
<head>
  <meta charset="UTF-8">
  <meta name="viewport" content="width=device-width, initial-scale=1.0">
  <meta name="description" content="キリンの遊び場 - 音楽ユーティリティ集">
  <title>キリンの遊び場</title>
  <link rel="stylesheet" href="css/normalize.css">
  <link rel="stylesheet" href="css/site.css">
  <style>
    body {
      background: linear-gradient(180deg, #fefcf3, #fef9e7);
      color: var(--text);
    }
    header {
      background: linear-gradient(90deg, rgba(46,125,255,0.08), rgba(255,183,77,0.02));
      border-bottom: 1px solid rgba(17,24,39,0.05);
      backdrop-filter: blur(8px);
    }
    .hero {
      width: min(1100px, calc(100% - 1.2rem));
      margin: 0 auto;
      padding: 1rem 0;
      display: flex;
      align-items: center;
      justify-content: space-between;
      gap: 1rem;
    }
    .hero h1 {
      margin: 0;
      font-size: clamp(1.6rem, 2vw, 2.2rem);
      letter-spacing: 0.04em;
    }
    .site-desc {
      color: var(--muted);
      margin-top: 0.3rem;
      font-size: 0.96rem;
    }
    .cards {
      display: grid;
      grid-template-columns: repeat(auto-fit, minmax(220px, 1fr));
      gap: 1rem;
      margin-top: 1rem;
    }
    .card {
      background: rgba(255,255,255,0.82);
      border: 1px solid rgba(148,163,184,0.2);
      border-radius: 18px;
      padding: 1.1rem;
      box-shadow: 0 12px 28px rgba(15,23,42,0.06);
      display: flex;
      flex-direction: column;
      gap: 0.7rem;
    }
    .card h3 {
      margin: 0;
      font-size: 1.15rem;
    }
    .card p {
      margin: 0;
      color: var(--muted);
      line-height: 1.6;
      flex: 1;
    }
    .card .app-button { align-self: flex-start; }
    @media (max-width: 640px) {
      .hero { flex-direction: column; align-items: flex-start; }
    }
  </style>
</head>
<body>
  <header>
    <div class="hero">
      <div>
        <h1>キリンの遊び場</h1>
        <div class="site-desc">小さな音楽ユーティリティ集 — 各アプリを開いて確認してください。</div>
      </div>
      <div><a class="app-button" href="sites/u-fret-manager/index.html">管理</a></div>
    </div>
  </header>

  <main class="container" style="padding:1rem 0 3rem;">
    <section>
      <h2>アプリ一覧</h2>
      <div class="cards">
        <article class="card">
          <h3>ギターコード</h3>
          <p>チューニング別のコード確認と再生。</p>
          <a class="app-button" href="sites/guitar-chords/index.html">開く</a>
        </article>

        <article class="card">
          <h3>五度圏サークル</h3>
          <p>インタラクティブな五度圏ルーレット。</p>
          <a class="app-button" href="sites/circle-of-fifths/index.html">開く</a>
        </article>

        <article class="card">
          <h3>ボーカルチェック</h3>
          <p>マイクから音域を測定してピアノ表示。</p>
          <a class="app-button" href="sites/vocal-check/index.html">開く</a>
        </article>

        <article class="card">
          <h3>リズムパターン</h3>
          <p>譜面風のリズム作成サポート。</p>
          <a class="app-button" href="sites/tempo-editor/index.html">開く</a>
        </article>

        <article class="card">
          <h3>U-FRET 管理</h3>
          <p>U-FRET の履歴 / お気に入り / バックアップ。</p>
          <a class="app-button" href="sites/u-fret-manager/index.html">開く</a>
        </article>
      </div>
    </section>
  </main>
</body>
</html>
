/* site.css — shared theme for kirins-playground */
:root {
  --primary: #2e7dff;
  --primary-700: #1a5ce6;
  --primary-soft: rgba(46, 125, 255, 0.1);
  --accent: #ffb74d;
  --accent-soft: rgba(255, 183, 77, 0.14);
  --bg: #f5f7fb;
  --surface: #ffffff;
  --surface-alt: #f8fafc;
  --text: #111827;
  --muted: #667085;
  --line: rgba(148, 163, 184, 0.26);
  --success: #1f9d68;
  --danger: #d9485f;
  --shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
  --radius: 16px;
  --container-w: 1100px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  min-height: 100vh;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: var(--text);
  background: var(--bg);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
img,svg { max-width: 100%; display: block; }
a { color: inherit; }
button, input, select, textarea { font: inherit; }
button {
  border: 1px solid var(--line);
  background: #fff;
  color: var(--text);
  border-radius: 10px;
  padding: 0.72rem 0.96rem;
  cursor: pointer;
  min-height: 44px;
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}
button:hover { transform: translateY(-1px); }
button:active { transform: translateY(0); }
button.primary {
  background: var(--primary);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 10px 20px rgba(46, 125, 255, 0.18);
}
button.ghost {
  background: transparent;
}
input, select, textarea {
  width: 100%;
  min-height: 44px;
  border-radius: 10px;
  border: 1px solid var(--line);
  background: #fff;
  padding: 0.7rem 0.8rem;
  color: var(--text);
}
textarea { min-height: 110px; resize: vertical; }
label {
  display: block;
  font-size: 0.94rem;
  color: var(--text);
}
label input, label select, label textarea { margin-top: 0.40rem; }

.container { width: min(var(--container-w), calc(100% - 2rem)); margin: 0 auto; }
.app-shell {
  width: min(var(--container-w), calc(100% - 1.2rem));
  margin: 0 auto;
  padding: 1.3rem 0 3rem;
}
.app-header {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 0.8rem;
  margin-bottom: 1rem;
}
.app-title {
  margin: 0;
  font-size: clamp(1.7rem, 3vw, 2.4rem);
  letter-spacing: 0.02em;
}
.app-subtitle {
  margin-top: 0.2rem;
  color: var(--muted);
}
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--primary);
  text-decoration: none;
  font-weight: 700;
  margin-bottom: 1rem;
}
.app-panel {
  background: rgba(255,255,255,0.88);
  border: 1px solid var(--line);
  border-radius: 22px;
  box-shadow: var(--shadow);
  padding: 1.1rem;
}
.row { display: flex; flex-wrap: wrap; gap: 0.8rem; align-items: center; }
.row-between { justify-content: space-between; }
.grid-2 { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; }
.grid-3 { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
.muted { color: var(--muted); }
.stack { display: grid; gap: 1rem; }
.badge {
  display: inline-flex;
  align-items: center;
  padding: 0.4rem 0.75rem;
  border-radius: 999px;
  font-weight: 700;
  font-size: 0.78rem;
}
.primary-badge {
  background: var(--primary-soft);
  color: var(--primary);
}

@media (max-width: 760px) {
  .grid-2, .grid-3 { grid-template-columns: 1fr; }
  .app-shell { width: min(var(--container-w), calc(100% - 0.8rem)); }
  .app-panel { padding: 0.9rem; }
}
